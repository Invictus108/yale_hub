# SpaceXAI / xAI. The agent loop calls https://api.x.ai/v1/responses with model grok-4.7.
# Without this key the server still boots, retrieves, and returns the retrieved context.
XAI_API_KEY=

# mock (default) shows a localhost NetID form. yale redirects to Yale CAS.
CAS_MODE=mock

PORT=3000

# Optional. Unset = the briefs "Send test email" button uses the stub sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=yalehub@localhost

# Existing Yale text-chunk index. Defaults to the sibling AI_girlfriend build.
YALE_EMBEDDINGS=../AI_girlfriend/backend/embeddings_with_text_v5.npz

# python on PATH is fine if sentence-transformers and numpy import there.
PYTHON=python

# Optional NetID for the stdio MCP process (npm run mcp). The HTTP app uses the login cookie instead.
YALEHUB_NETID=

# Google Calendar OAuth. Leave unset to keep events in data/calendar/ on this machine.
# Redirect URI in the Google Cloud client must match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/calendar/google/callback

# Yalies directory. Create a key at https://yalies.io/api. Course search does not need it.
YALIES_API_KEY=
