# Gemini answers and calls tools. Default model is gemini-4-hydrogen.
# Without this key the server still boots, retrieves, and returns the retrieved context.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Optional. Used only when GEMINI_API_KEY is empty.
XAI_API_KEY=

# Yale test CAS, same as Yale_Books. Allowlisted service is exactly
# http://localhost:5000/login_callback. Set CAS_MODE=mock for a local NetID form.
CAS_MODE=
ORIGIN=http://localhost:5000
CAS_LOGIN_URL=https://secure-tst.its.yale.edu/cas/login
CAS_VALIDATE_URL=https://secure-tst.its.yale.edu/cas/p3/serviceValidate
# Signs the login cookie. Defaults to a localhost value when unset.
SESSION_SECRET=

PORT=5000

# Optional. Unset = the briefs "Send test email" button uses the stub sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=yalehub@localhost

# Existing Yale text-chunk index. Defaults to the sibling AI_girlfriend build.
YALE_EMBEDDINGS=../AI_girlfriend/backend/embeddings_with_text_v5.npz
# Cross-encoder that reranks the BM25 + BGE pool. Default is BAAI/bge-reranker-v2-m3.
YALE_RERANKER=

# python on PATH is fine if sentence-transformers and numpy import there.
PYTHON=python

# Optional NetID for the stdio MCP process (npm run mcp). The HTTP app uses the login cookie instead.
YALEHUB_NETID=

# Google Calendar OAuth. Leave unset to keep events in data/calendar/ on this machine.
# Redirect URI in the Google Cloud client must match GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/google/callback

# Yalies directory. Create a key at https://yalies.io/api. Course search does not need it.
YALIES_API_KEY=

# Yale Canvas. Account, Settings, New Access Token. Read-only is enough.
CANVAS_API_TOKEN=
CANVAS_BASE_URL=https://canvas.yale.edu
